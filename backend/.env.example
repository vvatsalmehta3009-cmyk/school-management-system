# Environment Configuration Example
PROJECT_NAME="School Management Platform"
API_V1_STR="/api/v1"

# Database Connection (Neon or Local PostgreSQL)
DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/school_platform"

# Security & JWT (Generate a 32+ character random string for production)
SECRET_KEY="your-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
