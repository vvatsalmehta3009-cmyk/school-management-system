  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminUserCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentYearId",
      "value": "1",
      "type": "string"
