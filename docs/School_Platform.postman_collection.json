  "item": [
    {
      "name": "0. School Onboarding (Start Here!)",
      "item": [
        {
          "name": "0.1 Register New School & Master Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    pm.collectionVariables.set('adminUserCode', jsonData.admin_school_user_code);",
                  "    console.log('Admin registered! User Code: ' + jsonData.admin_school_user_code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_name\": \"Apex International School\",\n  \"school_code\": \"APEX\",\n  \"school_email\": \"contact@apexschool.com\",\n  \"school_phone\": \"9876543210\",\n  \"school_address\": \"123 Education Lane, Knowledge Park\",\n  \"admin_name\": \"Vikram Malhotra\",\n  \"admin_email\": \"vikram@apexschool.com\",\n  \"admin_phone\": \"9876543211\",\n  \"admin_password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/onboarding/school",
              "host": ["{{baseUrl}}"],
              "path": ["onboarding", "school"]
            },
            "description": "Atomically creates: 1. School, 2. Admin User, 3. Membership with code (e.g. APEX000001), 4. Assigns School Admin role, 5. Auto-saves JWT token!"
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Authentication & Context",
      "item": [
        {
          "name": "1.1 Login with Admin Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    console.log('Login successful! Token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_user_code\": \"{{adminUserCode}}\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in using the generated admin code and password."
          },
          "response": []
        },
        {
          "name": "1.2 Get My Profile & Active Context",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Checks the decoded JWT passport: returns user ID, active school, and assigned roles."
          },
          "response": []
        }
      ]
    },
