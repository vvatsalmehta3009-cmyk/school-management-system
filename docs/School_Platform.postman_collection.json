{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-4a5b-9c8d-7e8f9a0b1c2d",
    "name": "School Management Platform API",
    "description": "REST API collection for testing multi-tenant authentication, academic structure, and student management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Context",
      "item": [
        {
          "name": "1.1 Login (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    console.log('Access token automatically saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_user_code\": \"ABC000001\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user by school_user_code and password. The test script automatically saves the returned JWT into the {{accessToken}} variable for all other requests!"
          },
          "response": []
        },
        {
          "name": "1.2 Get My Profile & Active Context",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Fetches verified identity and active school context extracted directly from the JWT passport."
          },
          "response": []
        },
        {
          "name": "1.3 Get All My School Memberships",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/memberships",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "memberships"]
            },
            "description": "Returns all schools and roles associated with this user account (for the 'Switch School' menu)."
          },
          "response": []
        },
        {
          "name": "1.4 Switch School Context",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    console.log('New school token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_membership_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/switch-context",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "switch-context"]
            },
            "description": "Switches the active school context and issues a new JWT scoped to the target school."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Academic Structure",
      "item": [
        {
          "name": "2.1 List Academic Years",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/academic/years",
              "host": ["{{baseUrl}}"],
              "path": ["academic", "years"]
            },
            "description": "Fetches all academic calendar sessions for the active school."
          },
          "response": []
        },
        {
          "name": "2.2 List Classes",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/academic/classes",
              "host": ["{{baseUrl}}"],
              "path": ["academic", "classes"]
            },
            "description": "Lists permanent grade levels ordered by display_order."
          },
          "response": []
        },
        {
          "name": "2.3 Create Class (Grade 11)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grade 11\",\n  \"display_order\": 11\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/academic/classes",
              "host": ["{{baseUrl}}"],
              "path": ["academic", "classes"]
            },
            "description": "Creates a permanent grade level in the database. Notice school_id is injected from the token!"
          },
          "response": []
        },
        {
          "name": "2.4 List Sections",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/academic/sections",
              "host": ["{{baseUrl}}"],
              "path": ["academic", "sections"]
            },
            "description": "Lists active cohort sections for the active school."
          },
          "response": []
        },
        {
          "name": "2.5 Create Section",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academic_year_id\": 2,\n  \"class_id\": 4,\n  \"name\": \"C\",\n  \"capacity\": 35,\n  \"class_teacher_membership_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/academic/sections",
              "host": ["{{baseUrl}}"],
              "path": ["academic", "sections"]
            },
            "description": "Creates an active section (e.g. Grade 10-C) in academic year 2026-2027 with John Doe (id 1) assigned as class teacher!"
          },
          "response": []
        }
      ]
    },
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/health",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["health"]
        }
      },
      "response": []
    }
  ]
}
