// School Management Platform - Database Schema
// Use with VS Code DBML extensions or dbdiagram.io

Table schools {
  id bigint [pk, increment]
  name varchar(150) [not null]
  code varchar(50) [not null, unique]
  email varchar(255)
  phone varchar(20)
  address text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table academic_years {
  id bigint [pk, increment]
  school_id bigint [not null, ref: > schools.id]
  name varchar(50) [not null]
  start_date date [not null]
  end_date date [not null]
  is_current boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (school_id, name) [unique]
  }
}

Table classes {
  id bigint [pk, increment]
  school_id bigint [not null, ref: > schools.id]
  name varchar(50) [not null]
  display_order int [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (school_id, name) [unique]
    (school_id, display_order)
  }
}

Table sections {
  id bigint [pk, increment]
  academic_year_id bigint [not null, ref: > academic_years.id]
  class_id bigint [not null, ref: > classes.id]
  name varchar(20) [not null]
  capacity int
  class_teacher_membership_id bigint [ref: > school_memberships.id]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (academic_year_id, class_id, name) [unique]
  }
}

Table subjects {
  id bigint [pk, increment]
  school_id bigint [not null, ref: > schools.id]
  name varchar(100) [not null]
  code varchar(20) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (school_id, code) [unique]
  }
}

Table section_subject_teachers {
  id bigint [pk, increment]
  section_id bigint [not null, ref: > sections.id]
  subject_id bigint [not null, ref: > subjects.id]
  teacher_membership_id bigint [not null, ref: > school_memberships.id]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (section_id, subject_id) [unique]
  }
}

Table students {
  id bigint [pk, increment]
  school_id bigint [not null, ref: > schools.id]
  user_id bigint [ref: > users.id]
  admission_number varchar(50) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date [not null]
  gender varchar(20) [not null]
  blood_group varchar(5)
  admission_date date [not null]
  status varchar(20) [not null, default: 'active']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (school_id, admission_number) [unique]
  }
}

Table student_enrollments {
  id bigint [pk, increment]
  student_id bigint [not null, ref: > students.id]
  section_id bigint [not null, ref: > sections.id]
  academic_year_id bigint [not null, ref: > academic_years.id]
  roll_number varchar(10)
  enrolled_at date [not null, default: `CURRENT_DATE`]
  status varchar(20) [not null, default: 'enrolled']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, academic_year_id) [unique]
    (section_id, roll_number) [unique]
  }
}

Table users {
  id bigint [pk, increment]
  full_name varchar(150) [not null]
  email varchar(255)
  phone varchar(20)
  password_hash text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table school_memberships {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  school_id bigint [not null, ref: > schools.id]
  school_user_code varchar(30) [unique]
  status varchar(20) [not null, default: 'active']
  joined_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  left_at timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, school_id) [unique]
  }
}

Table roles {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
  description text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table permissions {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  description text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table user_roles {
  id bigint [pk, increment]
  school_membership_id bigint [not null, ref: > school_memberships.id]
  role_id bigint [not null, ref: > roles.id]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (school_membership_id, role_id) [unique]
  }
}

Table role_permissions {
  id bigint [pk, increment]
  role_id bigint [not null, ref: > roles.id]
  permission_id bigint [not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, permission_id) [unique]
  }
}
